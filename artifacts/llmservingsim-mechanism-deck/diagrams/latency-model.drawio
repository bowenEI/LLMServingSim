<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="26.0.9" pages="1">
  <diagram id="latency-model" name="计算、访存与通信时延如何汇聚为一次迭代">
    <mxGraphModel page="1" pageWidth="1600" pageHeight="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageBackgroundColor="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;计算、访存与通信时延如何汇聚为一次迭代&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#17324D;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="测量驱动的计算节点 + 解析内存/网络节点 + DAG 关键路径" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#60758A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="shape" value="&lt;b&gt;一次迭代的输入形状&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;x = (T, Nseq, prefill_chunk, kv_prefill, n_decode, kv_decode, TP, PP, EP, placement)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#AAB7C4;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="1500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="comp" value="&lt;b&gt;计算时延：测量驱动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;CSV: time_us → round(1000·time_us) ns&lt;br&gt;1D: t(x)=t0+(x−x0)(t1−t0)/(x1−x0)&lt;br&gt;Attention: 4D 多线性插值&lt;br&gt;Skew: t=tmean+α(tmax−tmean)&lt;br&gt;MoE: max_r lookup(tokens_r, experts_r)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F2FA;strokeColor=#2F6B9A;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="mem" value="&lt;b&gt;访存时延：容量 + 排队&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;KV/token/rank = 2·Hkv·Dhead·L·bkv / Nnpu&lt;br&gt;Nblock=floor((u·MNPU−W)/Bblock)&lt;br&gt;tmem(S)=Lmem+floor(S/Bmem)&lt;br&gt;PER_NODE / POOL：同设备 FIFO 串行&lt;br&gt;write-through 只计能耗；recall 在关键路径&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F4F1;strokeColor=#2A7F72;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="250" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="comm" value="&lt;b&gt;通信时延：消息 + collective&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;TP: S_AR = T·H·b&lt;br&gt;P/D: S_KV = 2·Hkv·Dhead·T·bkv / TP&lt;br&gt;EP: AG[(H+E)b], RS[Hb]&lt;br&gt;单跳: t=h·Llink+S/Blink&lt;br&gt;Ring 近似: AR≈2(N−1)(L+S/(N·B))&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0E3;strokeColor=#C86F2D;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="250" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dag" value="&lt;b&gt;统一为 Chakra DAG 的关键路径&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;start(v)=max_{u∈pred(v)} finish(u)&lt;br&gt;finish(v)=start(v)+d(v),  d(v)∈{tcomp,tmem,tcomm}&lt;br&gt;Titer=max_{v∈sink} finish(v)；重叠由依赖与资源队列自然产生，而不是简单求和&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="620" width="1240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend_comp" value="&lt;b&gt;COMP_NODE · profile replay&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F2FA;strokeColor=#2F6B9A;strokeWidth=2;fontColor=#17324D;fontFamily=Noto Sans CJK SC;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="440" height="50" as="geometry" />
